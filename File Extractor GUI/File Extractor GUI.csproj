<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>File_Extractor_GUI</RootNamespace>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Version>0.4.1</Version>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\file-extractor-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <EmbeddedResource Include="Data\DialogAudioTable.inc" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <Target Name="CopyBrxRebuilderAfterBuild" AfterTargets="Build">
    <PropertyGroup>
      <BrxRebuilderPath>$(MSBuildThisFileDirectory)..\Tools\BrxRebuilder\x64\$(Configuration)\Sly1BrxRebuilder.exe</BrxRebuilderPath>
    </PropertyGroup>
    <Copy SourceFiles="$(BrxRebuilderPath)"
          DestinationFolder="$(TargetDir)"
          Condition="Exists('$(BrxRebuilderPath)')" />
  </Target>

  <Target Name="CopyBrxRebuilderAfterPublish" AfterTargets="Publish">
    <PropertyGroup>
      <BrxRebuilderPath>$(MSBuildThisFileDirectory)..\Tools\BrxRebuilder\x64\$(Configuration)\Sly1BrxRebuilder.exe</BrxRebuilderPath>
    </PropertyGroup>
    <Copy SourceFiles="$(BrxRebuilderPath)"
          DestinationFolder="$(PublishDir)"
          Condition="Exists('$(BrxRebuilderPath)')" />
  </Target>
</Project>
