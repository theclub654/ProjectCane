<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>File_Extractor_GUI</RootNamespace>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Version>0.4.1</Version>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\file-extractor-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <EmbeddedResource Include="Data\DialogAudioTable.inc" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64' Or ('$(RuntimeIdentifier)' == '' And '$(OS)' == 'Windows_NT')">
    <ProjectReference Include="NativeTools\BrxRebuilder\Sly1BrxRebuilder.vcxproj"
                      ReferenceOutputAssembly="false"
                      AdditionalProperties="Platform=x64" />
    <ProjectReference Include="NativeTools\PalExtractor\Sly1PalExtractor.vcxproj"
                      ReferenceOutputAssembly="false"
                      AdditionalProperties="Platform=x64" />
    <EmbeddedResource Include="NativeTools\BrxRebuilder\x64\$(Configuration)\Sly1BrxRebuilder.exe"
                      LogicalName="ProjectCane.FileExtractor.Tools.Sly1BrxRebuilder.exe" />
    <EmbeddedResource Include="NativeTools\PalExtractor\x64\$(Configuration)\Sly1PalExtractor.exe"
                      LogicalName="ProjectCane.FileExtractor.Tools.Sly1PalExtractor.exe" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <EmbeddedResource Include="..\dist\linux-tools\Sly1BrxRebuilder"
                      LogicalName="ProjectCane.FileExtractor.Tools.Sly1BrxRebuilder"
                      Condition="Exists('..\dist\linux-tools\Sly1BrxRebuilder')" />
    <EmbeddedResource Include="..\dist\linux-tools\Sly1PalExtractor"
                      LogicalName="ProjectCane.FileExtractor.Tools.Sly1PalExtractor"
                      Condition="Exists('..\dist\linux-tools\Sly1PalExtractor')" />
  </ItemGroup>

</Project>
