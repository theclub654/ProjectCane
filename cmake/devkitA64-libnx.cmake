set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

set(DEVKITPRO "$ENV{DEVKITPRO}" CACHE PATH "devkitPro installation")
if(NOT DEVKITPRO)
    if(CMAKE_HOST_WIN32 AND EXISTS "C:/msys64/opt/devkitpro")
        set(DEVKITPRO "C:/msys64/opt/devkitpro" CACHE PATH "devkitPro installation" FORCE)
    else()
        set(DEVKITPRO "/opt/devkitpro" CACHE PATH "devkitPro installation" FORCE)
    endif()
endif()
set(CANE_HOST_SUFFIX "")
if(CMAKE_HOST_WIN32)
    set(CANE_HOST_SUFFIX ".exe")
endif()
set(CMAKE_C_COMPILER "${DEVKITPRO}/devkitA64/bin/aarch64-none-elf-gcc${CANE_HOST_SUFFIX}")
set(CMAKE_CXX_COMPILER "${DEVKITPRO}/devkitA64/bin/aarch64-none-elf-g++${CANE_HOST_SUFFIX}")
set(CMAKE_AR "${DEVKITPRO}/devkitA64/bin/aarch64-none-elf-ar${CANE_HOST_SUFFIX}")
set(CMAKE_RANLIB "${DEVKITPRO}/devkitA64/bin/aarch64-none-elf-ranlib${CANE_HOST_SUFFIX}")
set(CMAKE_EXECUTABLE_SUFFIX ".elf")
set(CMAKE_FIND_ROOT_PATH "${DEVKITPRO}/devkitA64/aarch64-none-elf" "${DEVKITPRO}/portlibs/switch" "${DEVKITPRO}/libnx")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_C_FLAGS_INIT "-march=armv8-a+crc+crypto -mtune=cortex-a57 -mtp=soft -ftls-model=local-exec -fPIE -ffunction-sections -fdata-sections -D__SWITCH__ -isystem ${DEVKITPRO}/libnx/include")
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-specs=${DEVKITPRO}/libnx/switch.specs -L${DEVKITPRO}/libnx/lib -Wl,--gc-sections")
