set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
if(NOT CANE_MINGW_ROOT)
 set(CANE_MINGW_ROOT "$ENV{CANE_MINGW_ROOT}" CACHE PATH "LLVM/MinGW installation")
endif()
if(NOT CANE_MINGW_ROOT)
 message(FATAL_ERROR "Set CANE_MINGW_ROOT to an LLVM/MinGW installation")
endif()
set(CMAKE_C_COMPILER "${CANE_MINGW_ROOT}/bin/x86_64-w64-mingw32-clang")
set(CMAKE_CXX_COMPILER "${CANE_MINGW_ROOT}/bin/x86_64-w64-mingw32-clang++")
set(CMAKE_RC_COMPILER "${CANE_MINGW_ROOT}/bin/x86_64-w64-mingw32-windres")
set(CMAKE_FIND_ROOT_PATH "${CANE_MINGW_ROOT}/x86_64-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
